+def _strict_measure_int(value: Any, label: str) -> int | None:
+    """测算数值字段：只接受整数（整数分/整数基点），拒绝错误类型与非有限数。
+
+    JSON 的 ``NaN``/``Infinity``/``1e400`` 会被解析为浮点非有限数；布尔与数字字符串
+    在宽松模式下可能被静默转成整数，这里一律按“错误类型”拒绝并给出中文原因。
+    """
+
+    if value is None:
+        return None
+    if isinstance(value, bool):
+        raise ValueError(f"{label}必须为整数，不能是布尔值")
+    if isinstance(value, float):
+        if not math.isfinite(value):
+            raise ValueError(f"{label}必须为有限数，不能是 NaN 或 Infinity")
+        if not value.is_integer():
+            raise ValueError(f"{label}必须为整数，不能是小数")
+        return int(value)
+    if isinstance(value, int):
+        return value
+    raise ValueError(f"{label}必须为整数，不能是字符串或其他类型")
