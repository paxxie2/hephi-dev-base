new file mode 100644
index 0000000..a363107
--- /dev/null
+++ b/backend/app/validation_messages.py
@@ -0,0 +1,88 @@
+"""把 Pydantic 校验错误转换成面向用户的**中文字段级**提示。
+
+HTTP 路由（``app.main`` 的 ``RequestValidationError`` 处理器）与两处手工
+``ScenarioRequest`` 构造（测评服务 ``_coerce_request``、对话工具 ``create_scenario``）
+共用本模块，保证无论从哪个入口提交非法测算参数，``fieldErrors`` 都是明确字段 + 中文信息，
+而不是 Pydantic 的英文默认消息。
+"""
+
+from __future__ import annotations
+
+from typing import Any, Iterable
+
+# 字段名 → 中文标签；未列出的字段回退为字段名本身。
+FIELD_LABELS: dict[str, str] = {
+    # 测算
+    "kind": "测算类型",
+    "monthlyRentCents": "新月租金",
+    "shareBps": "分成比例（整数基点）",
+    "recoveryKind": "恢复对象",
+    "recoveryBps": "恢复比例（整数基点）",
+    "repairCostCents": "一次性维修费",
+    # 诊断 / 消息 / 分页 / 请求头（同一错误格式的其它路由）
+    "siteId": "点位",
+    "startDate": "开始日期",
+    "endDate": "结束日期",
+    "text": "消息内容",
+    "limit": "分页大小",
+    "offset": "分页偏移",
+    "Idempotency-Key": "幂等键",
+}
+
+_LOCATION_PREFIXES = {"body", "query", "path", "header", "cookie"}
+
+
+def _leaf_field(location: Iterable[Any]) -> str:
+    parts = [str(part) for part in location if str(part) not in _LOCATION_PREFIXES]
+    return parts[-1] if parts else "body"
+
+
+def _message_for(error: dict[str, Any], field: str) -> str:
+    label = FIELD_LABELS.get(field, field)
+    error_type = str(error.get("type") or "")
+    context = error.get("ctx") or {}
+
+    # 自定义 field_validator 抛出的 ValueError：消息本身已是中文且可操作。
+    if error_type == "value_error":
+        detail = str(context.get("error") or "").strip()
+        return detail or f"{label}不合法"
+
+    if error_type == "missing":
+        return f"{label}为必填"
+    if error_type == "extra_forbidden":
+        return f"不支持字段「{field}」：未知或与当前测算类型无关"
+    if error_type in ("literal_error", "enum"):
+        expected = context.get("expected")
+        return f"{label}只能是{expected}" if expected else f"{label}取值不合法"
+    if error_type in (
+        "int_type",
+        "int_parsing",
+        "int_from_float",
+        "bool_type",
+        "bool_parsing",
+        "string_type",
+    ):
+        return f"{label}必须为整数"
+    if error_type in ("finite_number", "nan", "infinity"):
+        return f"{label}必须为有限数，不能是 NaN 或 Infinity"
+    if error_type in ("greater_than_equal", "greater_than"):
+        boundary = context.get("ge", context.get("gt"))
+        return f"{label}不能小于 {boundary}"
+    if error_type in ("less_than_equal", "less_than"):
+        boundary = context.get("le", context.get("lt"))
+        return f"{label}不能大于 {boundary}"
+    if error_type == "string_too_short":
+        return f"{label}不能为空"
+    if error_type == "string_too_long":
+        return f"{label}过长"
+    return f"{label}不合法"
+
+
+def chinese_field_errors(errors: Iterable[dict[str, Any]]) -> dict[str, str]:
+    """``{字段: 中文提示}``；同字段多个错误只保留第一条（前端按字段展示）。"""
+
+    result: dict[str, str] = {}
+    for error in errors:
+        field = _leaf_field(error.get("loc", ()))
+        result.setdefault(field, _message_for(error, field))
+    return result
diff --git a/backend/tests/test_scenario_schema_validation.py b/backend/tests/test_scenario_schema_validation.py
new file mode 100644
index 0000000..3d50e93
--- /dev/null
+++ b/backend/tests/test_scenario_schema_validation.py
@@ -0,0 +1,126 @@
+"""测算请求的字段级输入校验（纯 schema 测试，不依赖播种数据库）。
+
+覆盖需求：拒绝缺失、错误类型（数字字符串/布尔/小数）、非有限数（NaN/Infinity）、
+越界/负数保留给业务层，并用中文给出明确字段；未知字段与 kind 不一致的字段被拒绝。
+
+说明：本文件只依赖 ``app.schemas``（不 import ``app.data``），因此可在干净基线的
+反向复现 worktree 中直接运行；范围/负数等业务校验由 ``app.services.scenarios`` 与
+``app.domain.scenarios`` 负责，见 ``test_scenario_api.py`` 与 ``test_scenarios.py``。
+"""
+
+from __future__ import annotations
+
+import math
+
+import pytest
+from pydantic import ValidationError
+
+from app.schemas import ScenarioRequest
+
+
+def _validation_errors(payload: dict) -> dict[str, str]:
+    with pytest.raises(ValidationError) as exc_info:
+        ScenarioRequest.model_validate(payload)
+    messages: dict[str, str] = {}
+    for error in exc_info.value.errors():
+        location = [str(part) for part in error.get("loc", ()) if part != "body"]
+        messages[".".join(location) or "body"] = str(error.get("msg") or "")
+    return messages
+
+
+@pytest.mark.parametrize(
+    ("payload", "field", "expected_fragment"),
+    [
+        # 错误类型：数字字符串/布尔/小数不能被静默转成整数
+        ({"kind": "rent", "monthlyRentCents": "10000"}, "monthlyRentCents", "必须为整数"),
+        ({"kind": "rent", "monthlyRentCents": True}, "monthlyRentCents", "不能是布尔值"),
+        ({"kind": "rent", "monthlyRentCents": 1.5}, "monthlyRentCents", "不能是小数"),
+        ({"kind": "share", "shareBps": "5000"}, "shareBps", "必须为整数"),
+        ({"kind": "share", "shareBps": False}, "shareBps", "不能是布尔值"),
+        (
+            {"kind": "recovery", "recoveryKind": "offline", "recoveryBps": 5000, "repairCostCents": "0"},
+            "repairCostCents",
+            "必须为整数",
+        ),
+        # 非有限数
+        ({"kind": "rent", "monthlyRentCents": math.nan}, "monthlyRentCents", "必须为有限数"),
+        ({"kind": "rent", "monthlyRentCents": math.inf}, "monthlyRentCents", "必须为有限数"),
+        ({"kind": "share", "shareBps": -math.inf}, "shareBps", "必须为有限数"),
+        # kind / recoveryKind 取值错误
+        ({"kind": 123, "monthlyRentCents": 100}, "kind", "测算类型只能是"),
+        (
+            {"kind": "recovery", "recoveryKind": "bogus", "recoveryBps": 1000, "repairCostCents": 0},
+            "recoveryKind",
+            "恢复对象只能是 offline 或 slot",
+        ),
+    ],
+)
+def test_rejects_wrong_type_and_non_finite_with_chinese_message(
+    payload: dict, field: str, expected_fragment: str
+) -> None:
+    messages = _validation_errors(payload)
+    assert field in messages, f"应返回字段级错误: {messages}"
+    assert expected_fragment in messages[field], messages[field]
+    assert "Input should" not in messages[field], "不得把 Pydantic 英文默认消息透给用户"
+
+
+def test_rejects_unknown_field() -> None:
+    messages = _validation_errors({"kind": "rent", "monthlyRentCents": 100, "foo": 1})
+    assert "foo" in messages, f"未知字段必须被拒绝（extra=forbid）: {messages}"
+
+
+def test_rejects_missing_kind() -> None:
+    messages = _validation_errors({"monthlyRentCents": 100})
+    assert "kind" in messages
+
+
+def test_structural_errors_are_translated_to_chinese() -> None:
+    from app.validation_messages import chinese_field_errors
+
+    translated = chinese_field_errors(
+        [
+            {"loc": ("kind",), "type": "missing", "msg": "Field required"},
+            {"loc": ("foo",), "type": "extra_forbidden", "msg": "Extra inputs are not permitted"},
+        ]
+    )
+    assert "必填" in translated["kind"]
+    assert translated["foo"].startswith("不支持字段")
+
+
+def test_negative_and_out_of_range_values_are_business_layer_concerns() -> None:
+    """schema 只做类型/有限性；负数与越界仍由服务/领域层给中文范围错误。"""
+
+    assert ScenarioRequest(kind="rent", monthlyRentCents=-1).monthlyRentCents == -1
+    assert ScenarioRequest(kind="share", shareBps=10001).shareBps == 10001
+    assert (
+        ScenarioRequest(
+            kind="recovery", recoveryKind="offline", recoveryBps=-1, repairCostCents=-5
+        ).repairCostCents
+        == -5
+    )
+
+
+def test_accepts_valid_requests() -> None:
+    rent = ScenarioRequest.model_validate({"kind": "rent", "monthlyRentCents": 20000})
+    assert rent.monthlyRentCents == 20000
+
+    # 整数值的浮点在 JSON 数字语义下等价于整数；只拒绝非整数小数。
+    integral = ScenarioRequest.model_validate({"kind": "rent", "monthlyRentCents": 100.0})
+    assert integral.monthlyRentCents == 100
+
+    share = ScenarioRequest.model_validate({"kind": "share", "shareBps": 0})
+    assert share.shareBps == 0
+    share_max = ScenarioRequest.model_validate({"kind": "share", "shareBps": 10000})
+    assert share_max.shareBps == 10000
+
+    recovery = ScenarioRequest.model_validate(
+        {
+            "kind": "recovery",
+            "recoveryKind": "slot",
+            "recoveryBps": 5000,
+            "repairCostCents": 0,
+        }
+    )
+    assert recovery.recoveryKind == "slot"
+    assert recovery.recoveryBps == 5000
+    assert recovery.repairCostCents == 0
