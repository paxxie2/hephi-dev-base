new file mode 100644
index 0000000..2cdfffb
--- /dev/null
+++ b/backend/app/validation_messages.py
@@ -0,0 +1,105 @@
+"""把 Pydantic 校验错误转换为面向用户的**中文字段级**提示。
+
+HTTP 请求体校验（``app.main`` 的 ``RequestValidationError`` 处理器）、测算服务
+``_coerce_request``、对话受控工具 ``create_scenario`` 共用本模块：无论从哪个入口
+提交非法测算参数，``fieldErrors`` 都是「明确字段 + 中文可操作信息」，而不是
+Pydantic 的英文默认消息。
+
+字段标签统一使用测算接口的单位（整数分 / 整数基点），与 INTERFACES 第 4.2 节
+的错误结构 ``{code, message, fieldErrors, requestId}`` 配套。
+"""
+
+from __future__ import annotations
+
+from typing import Any, Iterable
+
+# 字段名 → 中文标签（含单位）；未列出的字段回退为字段名本身。
+FIELD_LABELS: dict[str, str] = {
+    "kind": "测算类型",
+    "monthlyRentCents": "新月租金（整数分）",
+    "shareBps": "分成比例（整数基点）",
+    "recoveryKind": "恢复对象",
+    "recoveryBps": "恢复比例（整数基点）",
+    "repairCostCents": "一次性维修费（整数分）",
+    # 同格式错误响应的其它路由 / 工具参数
+    "siteId": "点位",
+    "startDate": "开始日期",
+    "endDate": "结束日期",
+    "text": "消息内容",
+    "limit": "分页大小",
+    "offset": "分页偏移",
+    "body": "请求体",
+    "arguments": "工具参数",
+}
+
+# Pydantic loc 里的“来源”前缀不是字段名。
+_LOCATION_PREFIXES = {"body", "query", "path", "header", "cookie"}
+
+# 整数概念字段的类型错误统一提示为“必须为整数”，避免英文默认消息。
+_INT_TYPE_ERRORS = (
+    "int_type",
+    "int_parsing",
+    "int_from_float",
+    "bool_type",
+    "bool_parsing",
+    "float_type",
+)
+# JSON 的 NaN/Infinity/1e400 会被 json.loads 解析为浮点非有限数。
+_NON_FINITE_ERRORS = ("finite_number", "nan", "infinity", "float_finite")
+# 请求体不是 JSON 对象（例如数组/字符串）。
+_STRUCT_TYPE_ERRORS = ("dict_type", "model_type", "model_attributes_type")
+
+
+def _leaf_field(location: Iterable[Any]) -> str:
+    """取错误位置中最末端的字段名（跳过 body/query/header 等来源前缀）。"""
+    parts = [str(part) for part in location if str(part) not in _LOCATION_PREFIXES]
+    return parts[-1] if parts else "body"
+
+
+def _message_for(error: dict[str, Any], field: str) -> str:
+    label = FIELD_LABELS.get(field, field)
+    error_type = str(error.get("type") or "")
+    context = error.get("ctx") or {}
+
+    # 自定义字段校验器抛出的 ValueError：消息本身已是中文且可操作，直接采用。
+    if error_type == "value_error":
+        detail = str(context.get("error") or "").strip()
+        return detail or f"{label}不合法"
+
+    if error_type == "missing":
+        return f"{label}为必填"
+    if error_type in _STRUCT_TYPE_ERRORS:
+        return f"{label}必须是 JSON 对象"
+    if error_type in _NON_FINITE_ERRORS:
+        return f"{label}必须为有限数，不能是 NaN 或 Infinity"
+    if error_type in _INT_TYPE_ERRORS:
+        return f"{label}必须为整数"
+    if error_type in ("literal_error", "enum"):
+        expected = context.get("expected")
+        return f"{label}只能是{expected}" if expected else f"{label}取值不合法"
+    if error_type == "extra_forbidden":
+        return f"不支持字段「{field}」：未知或与当前测算类型无关"
+    if error_type in ("greater_than_equal", "greater_than"):
+        boundary = context.get("ge", context.get("gt"))
+        return f"{label}不能小于 {boundary}"
+    if error_type in ("less_than_equal", "less_than"):
+        boundary = context.get("le", context.get("lt"))
+        return f"{label}不能大于 {boundary}"
+    if error_type == "string_too_short":
+        return f"{label}不能为空"
+    if error_type == "string_too_long":
+        return f"{label}过长"
+    return f"{label}不合法"
+
+
+def chinese_field_errors(errors: Iterable[dict[str, Any]]) -> dict[str, str]:
+    """``{字段: 中文提示}``；同一字段多个错误只保留第一条（前端按字段展示）。"""
+
+    result: dict[str, str] = {}
+    for error in errors:
+        field = _leaf_field(error.get("loc", ()))
+        result.setdefault(field, _message_for(error, field))
+    return result
+
+
+__all__ = ["FIELD_LABELS", "chinese_field_errors"]
