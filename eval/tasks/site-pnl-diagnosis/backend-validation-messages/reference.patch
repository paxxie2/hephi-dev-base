+def test_scenario_strict_types_non_finite_and_chinese_field_errors(client):
+    """绕过前端的非法参数逐类拒绝：缺失/错误类型/非有限数/负数/越界，返回中文字段级错误。"""
+    diagnosis = _new_diagnosis(client, key="strict-diag")
+    diagnosis_id = diagnosis["id"]
+    cases = [
+        (json.dumps({}), "kind", "必填"),
+        (json.dumps({"kind": "discount"}), "kind", "rent"),
+        (json.dumps({"kind": "rent", "monthlyRentCents": "100"}), "monthlyRentCents", "必须为整数"),
+        (json.dumps({"kind": "rent", "monthlyRentCents": True}), "monthlyRentCents", "布尔"),
+        (json.dumps({"kind": "rent", "monthlyRentCents": 100.5}), "monthlyRentCents", "小数"),
+        ('{"kind": "rent", "monthlyRentCents": NaN}', "monthlyRentCents", "有限数"),
+        ('{"kind": "rent", "monthlyRentCents": Infinity}', "monthlyRentCents", "有限数"),
+        ('{"kind": "rent", "monthlyRentCents": 1e400}', "monthlyRentCents", "有限数"),
+        (json.dumps({"kind": "rent", "monthlyRentCents": -1}), "monthlyRentCents", "不能为负数"),
+        (json.dumps({"kind": "share", "shareBps": "500"}), "shareBps", "必须为整数"),
+        (json.dumps({"kind": "share", "shareBps": 10001}), "shareBps", "10000"),
+        (
+            json.dumps(
+                {"kind": "recovery", "recoveryKind": "bogus", "recoveryBps": 5000, "repairCostCents": 0}
+            ),
+            "recoveryKind",
+            "offline",
+        ),
+        (
+            json.dumps(
+                {"kind": "recovery", "recoveryKind": "offline", "recoveryBps": 5000, "repairCostCents": -1}
+            ),
+            "repairCostCents",
+            "不能为负数",
+        ),
+        (
+            '{"kind": "recovery", "recoveryKind": "offline", "recoveryBps": NaN, "repairCostCents": 0}',
+            "recoveryBps",
+            "有限数",
+        ),
+        (json.dumps([]), "body", "JSON 对象"),
+    ]
+    for index, (raw_body, expected_field, expected_text) in enumerate(cases):
+        response = _post_scenario_raw(client, diagnosis_id, raw_body, key=f"strict-{index}")
+        assert response.status_code == 400, (raw_body, response.text)
+        body = response.json()
+        assert set(body) >= {"code", "message", "fieldErrors", "requestId"}, body
+        assert expected_field in body["fieldErrors"], (raw_body, body)
+        message = body["fieldErrors"][expected_field]
+        assert expected_text in message, (raw_body, message)
+        assert any("\u4e00" <= char <= "\u9fff" for char in message), (raw_body, message)
+        assert "Input should" not in message, (raw_body, message)
+
+    # 所有非法请求都不得写入测算记录。
+    listing = client.get(f"/api/diagnoses/{diagnosis_id}/scenarios").json()
+    assert listing["total"] == 0
+
+
+def test_scenario_valid_after_invalid_attempts_computes_and_persists(client):
+    """先提交非法参数被拒、再提交合法参数：正常测算并保存，且已有记录不被改写。"""
+    diagnosis = _new_diagnosis(client, key="fix-then-ok-diag")
+    diagnosis_id = diagnosis["id"]
+
+    invalid = _post_scenario(client, diagnosis_id, {"kind": "rent", "monthlyRentCents": -100}, key="fix-1")
+    assert invalid.status_code == 400
+    assert "monthlyRentCents" in invalid.json()["fieldErrors"]
+    assert client.get(f"/api/diagnoses/{diagnosis_id}/scenarios").json()["total"] == 0
+
+    valid = _post_scenario(
+        client, diagnosis_id, {"kind": "rent", "monthlyRentCents": 2000000}, key="fix-2"
+    )
+    assert valid.status_code == 201, valid.text
+    scenario = valid.json()
+    assert scenario["kind"] == "rent"
+    assert scenario["status"] == "computed"
+    assert scenario["inputs"]["monthlyRentCents"] == 2000000
+
+    listing = client.get(f"/api/diagnoses/{diagnosis_id}/scenarios").json()
+    assert listing["total"] == 1
+    assert listing["items"][0]["id"] == scenario["id"]
+
