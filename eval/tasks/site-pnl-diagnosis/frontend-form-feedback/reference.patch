+      await page.getByTestId("repair-cost").fill("10");
+      const [recoveryResponse] = await Promise.all([
+        page.waitForResponse(
+          (r) => r.url().includes("/scenarios") && r.request().method() === "POST",
+          { timeout: 60_000 },
+        ),
+        page.getByTestId("recovery-submit").click(),
+      ]);
+      expect(recoveryResponse.status()).toBe(201);
+      const recovery = await waitForNewScenario(page, diagnosisId, "recovery", recoveryIds);
+      expect(["computed", "unavailable"]).toContain(recovery.status);
+      await expect(page.getByTestId("scenario-status").first()).toHaveText(
+        recovery.status === "computed" ? "已计算" : "不可测算",
+      );
+      await log.shot(page, "修正后恢复测算成功保存", `scenarioId=${recovery.id} status=${recovery.status}`);
+
+      // ---------------------------------------------------------------- 绕过前端（真实 HTTP）
+      const beforeBypass = (await savedScenarios(page, diagnosisId)).total;
+      const bypassCases: Array<{ name: string; raw: string; field: string; fragment: string }> = [
+        {
+          name: "租金负数",
+          raw: '{"kind":"rent","monthlyRentCents":-1}',
+          field: "monthlyRentCents",
+          fragment: "负数",
+        },
+        {
+          name: "分成越界",
+          raw: '{"kind":"share","shareBps":10001}',
+          field: "shareBps",
+          fragment: "0 到 10000",
+        },
+        {
+          name: "租金非有限数",
+          raw: '{"kind":"rent","monthlyRentCents":NaN}',
+          field: "monthlyRentCents",
+          fragment: "有限数",
+        },
+        {
+          name: "分成错误类型",
+          raw: '{"kind":"share","shareBps":"abc"}',
+          field: "shareBps",
+          fragment: "整数",
+        },
+        {
+          name: "租金布尔类型",
+          raw: '{"kind":"rent","monthlyRentCents":true}',
+          field: "monthlyRentCents",
+          fragment: "布尔",
+        },
+        {
+          name: "未知字段",
+          raw: '{"kind":"rent","monthlyRentCents":100,"unexpected":1}',
+          field: "unexpected",
+          fragment: "不支持字段",
+        },
+      ];
+      const bypassResults: Array<Record<string, unknown>> = [];
+      for (const [index, item] of bypassCases.entries()) {
+        const response = await page.request.post(`/api/diagnoses/${diagnosisId}/scenarios`, {
+          // 用原始字节发送，确保 NaN/Infinity 等 JSON 字面量原样到达后端（Playwright 的字符串 data 会被编码）。
+          data: Buffer.from(item.raw, "utf8"),
+          headers: {
+            "Content-Type": "application/json",
+            // HTTP 头必须是 ASCII；用例名只用于日志，不放进 header。
+            "Idempotency-Key": `e2e-bypass-${index}`,
+          },
+        });
+        expect(response.status(), `${item.name} 绕过前端也必须被拒绝`).toBe(400);
+        const body = (await response.json()) as { code: string; fieldErrors: Record<string, string> };
+        expect(
+          body.fieldErrors[item.field],
+          `${item.name} 应返回字段级错误: ${JSON.stringify(body)}`,
+        ).toContain(item.fragment);
+        expect(body.fieldErrors[item.field], "字段错误必须是中文，不得透出 Pydantic 英文").not.toContain(
+          "Input should",
+        );
+        bypassResults.push({ name: item.name, status: response.status(), fieldErrors: body.fieldErrors });
+      }
+      const afterBypass = (await savedScenarios(page, diagnosisId)).total;
+      expect(afterBypass, "绕过前端的非法提交不得写入成功测算记录").toBe(beforeBypass);
+
+      // 合法输入仍被接受（证明拒绝的是非法参数，而不是接口整体失败）。
+      const validBypass = await page.request.post(`/api/diagnoses/${diagnosisId}/scenarios`, {
+        data: { kind: "rent", monthlyRentCents: 800000 },
+        headers: { "Idempotency-Key": "e2e-bypass-valid" },
+      });
+      expect(validBypass.status(), "合法参数必须继续可用").toBe(201);
+      expect((await savedScenarios(page, diagnosisId)).total).toBe(afterBypass + 1);
+
+      log.record("绕过前端非法提交", { bypassResults, beforeBypass, afterBypass });
+      await log.shot(page, "绕过前端非法提交全部 400 且未落库", `已保存=${afterBypass}`);
+    } finally {
+      log.flush();
+    }
+  });
+});
