diff --git a/acceptance/test_business_http.py b/acceptance/test_business_http.py
index 36f6f9b..b9b1a6f 100644
--- a/acceptance/test_business_http.py
+++ b/acceptance/test_business_http.py
@@ -829,6 +829,54 @@ def test_scenario_validation_errors(
     assert_error_shape(response.json())
 
 
+@pytest.mark.parametrize(
+    ("name", "raw_body", "expected_field", "expected_fragment"),
+    [
+        # 非有限数（JSON 允许 NaN/Infinity 字面量；必须按错误类型拒绝，不能进入计算）
+        ("租金NaN", '{"kind":"rent","monthlyRentCents":NaN}', "monthlyRentCents", "有限数"),
+        ("分成Infinity", '{"kind":"share","shareBps":Infinity}', "shareBps", "有限数"),
+        # 错误类型（不能被宽松转成整数后落库）
+        ("租金字符串", '{"kind":"rent","monthlyRentCents":"abc"}', "monthlyRentCents", "整数"),
+        ("分成布尔", '{"kind":"share","shareBps":true}', "shareBps", "布尔"),
+        ("租金小数", '{"kind":"rent","monthlyRentCents":1.5}', "monthlyRentCents", "小数"),
+        # 未知/缺失字段
+        ("未知字段", '{"kind":"rent","monthlyRentCents":100,"unexpected":1}', "unexpected", "不支持字段"),
+        ("缺少kind", '{"monthlyRentCents":100}', "kind", "必填"),
+    ],
+)
+def test_scenario_validation_rejects_wrong_types_with_chinese_field_errors(
+    client: httpx.Client,
+    default_diagnoses: dict[str, dict[str, Any]],
+    name: str,
+    raw_body: str,
+    expected_field: str,
+    expected_fragment: str,
+) -> None:
+    """绕过前端直接提交非法测算参数：400 字段级**中文**错误，且不写入成功测算记录。"""
+    diagnosis = default_diagnoses["S01"]
+    total_url = f"/api/diagnoses/{diagnosis['id']}/scenarios"
+    before = client.get(total_url, params={"limit": 1}).json()["total"]
+
+    response = client.post(
+        total_url,
+        content=raw_body,
+        headers={"Content-Type": "application/json", "Idempotency-Key": uuid.uuid4().hex},
+    )
+    assert response.status_code == 400, f"{name}: 期望 400，实际 {response.status_code} {response.text}"
+    body = response.json()
+    assert_error_shape(body)
+    assert body["code"] == "VALIDATION_ERROR", f"{name}: 非法类型应为 VALIDATION_ERROR，实际 {body['code']}"
+    assert expected_field in body["fieldErrors"], f"{name}: 缺少字段级错误 {expected_field}: {body['fieldErrors']}"
+    message = body["fieldErrors"][expected_field]
+    assert expected_fragment in message, f"{name}: 错误信息不可操作（应含「{expected_fragment}」）：{message}"
+    assert "Input should" not in message and "Field required" not in message, (
+        f"{name}: 不得把 Pydantic 英文默认消息透给用户：{message}"
+    )
+
+    after = client.get(total_url, params={"limit": 1}).json()["total"]
+    assert after == before, f"{name}: 非法输入不得写入成功测算记录（before={before}, after={after}）"
+
+
 # ---------------------------------------------------------------- 对话（真实模型 / 未配置如实处理）
 
 
