+                    refund_rows.append(
+                        (f"RFD-{spec.id}-{refund_seq:05d}", spec.id, order_id,
+                         f"{refund_date_str}T{hour:02d}:{minute:02d}:00+08:00",
+                         refund_date_str, amount, DATA_VERSION)
+                    )
+
+            # ---- 客流
+            if day_str not in missing.get("traffic_daily", set()):
+                traffic_rows.append(
+                    (f"TRF-{spec.id}-{day_str}", spec.id, day_str, _daily_visitors(spec, day), DATA_VERSION)
+                )
+
+            # ---- 营业时段
+            if day_str not in missing.get("business_hours", set()):
+                business_hour_rows.append(
+                    (f"BH-{spec.id}-{day_str}", spec.id, day_str,
+                     BUSINESS_OPEN_MINUTE, BUSINESS_CLOSE_MINUTE, DATA_VERSION)
+                )
+
+            # ---- 设备小时与仓位故障
+            if day_str not in missing.get("device_hours", set()):
+                for device_index, device in enumerate(spec.devices):
+                    offline = _is_offline_day(spec, day) and spec.offline_device_index == device_index
+                    for hour in BUSINESS_HOURS:
+                        device_hour_rows.append(
+                            (f"DH-{spec.id}-{device_index + 1:02d}-{day_str}-{hour:02d}",
+                             spec.id, f"DEV-{spec.id}-{device_index + 1:02d}", day_str, hour,
+                             "offline" if offline else "online", device.planned_capacity, DATA_VERSION)
+                        )
+            if day_str not in missing.get("slot_faults", set()) and _is_fault_day(day):
+                for device_index in spec.fault_devices:
+                    for hour in spec.fault_hours:
+                        slot_fault_rows.append(
+                            (f"SF-{spec.id}-{device_index + 1:02d}-{day_str}-{hour:02d}",
+                             spec.id, f"DEV-{spec.id}-{device_index + 1:02d}", day_str, hour,
+                             spec.faulted_slots, DATA_VERSION)
+                        )
+
+            # ---- 覆盖清单（expected=1）：缺行即缺记录
+            for source_type in SOURCE_TYPES:
+                if day_str in missing.get(source_type, set()):
+                    continue
+                coverage_rows.append((spec.id, source_type, day_str, 1, DATA_VERSION))
+
+    _insert(conn, "sites", sites_rows)
+    _insert(conn, "devices", device_rows)
+    _insert(conn, "orders", order_rows)
+    _insert(conn, "refunds", refund_rows)
+    _insert(conn, "traffic_daily", traffic_rows)
+    _insert(conn, "business_hours", business_hour_rows)
+    _insert(conn, "device_hours", device_hour_rows)
+    _insert(conn, "slot_faults", slot_fault_rows)
+    _insert(conn, "maintenance_fees", maintenance_rows)
+    _insert(conn, "payment_fees", payment_fee_rows)
+    _insert(conn, "rent_contracts", rent_rows)
+    _insert(conn, "share_contracts", share_rows)
+    _insert(conn, "coverage", coverage_rows)
+
+    meta_rows = [
+        ("data_version", DATA_VERSION),
+        ("seed", DATASET_SEED),
+        ("seeded_at", time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())),
+        ("dataset_start", DATASET_START_DATE),
+        ("dataset_end", DATASET_END_DATE),
+    ]
+    conn.executemany(  # type: ignore[attr-defined]
+        "INSERT INTO app_meta (key, value) VALUES (?, ?) "
+        "ON CONFLICT(key) DO UPDATE SET value = excluded.value",
+        meta_rows,
+    )
+
+
+def _insert(conn: object, table: str, rows: list[tuple[object, ...]]) -> None:
+    if not rows:
+        return
+    placeholders = ", ".join("?" for _ in rows[0])
+    conn.executemany(  # type: ignore[attr-defined]
+        f"INSERT INTO {table} VALUES ({placeholders})", rows
+    )
+
+
+def seed_database(db_path: str) -> None:
+    """只在空库播种固定模拟数据；已有数据时直接返回（绝不重置）。"""
+    init_db(db_path)
+    conn = connect(db_path)
+    try:
+        existing = conn.execute("SELECT COUNT(*) AS c FROM sites").fetchone()
+        if existing and existing["c"] > 0:
+            return
+        try:
+            _generate(conn)
+            conn.commit()
+        except Exception:
+            conn.rollback()
+            raise
+        try:
+            conn.execute("PRAGMA wal_checkpoint(TRUNCATE)")
+        except Exception:  # pragma: no cover - checkpoint 是尽力而为
+            pass
+    finally:
+        conn.close()
