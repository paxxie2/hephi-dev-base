+/**
+ * 旅程 8（工单 #7 验收）：假设测算输入校验与可操作错误提示。
+ *
+ * 真实浏览器 + 真实后端（禁止 mock 业务接口）：
+ * 非法输入 → 看到具体字段错误 → 修正 → 成功测算并保存；
+ * 同时用同源真实 HTTP 请求绕过前端提交非法参数，断言 400 且不写入成功测算记录。
+ */
+import { Buffer } from "node:buffer";
+import { expect, test } from "@playwright/test";
+import type { Page } from "@playwright/test";
+import { apiGet, createJourneyLog, startDiagnosis } from "./helpers";
+
+interface ScenarioItem {
+  id: string;
+  kind: string;
+  inputs: Record<string, unknown>;
+  status: string;
+}
+
+interface ScenarioList {
+  items: ScenarioItem[];
+  total: number;
+}
+
+async function savedScenarios(page: Page, diagnosisId: string): Promise<ScenarioList> {
+  return (await apiGet(page, `/api/diagnoses/${diagnosisId}/scenarios?limit=100`)).body as ScenarioList;
+}
+
+async function waitForNewScenario(
+  page: Page,
+  diagnosisId: string,
+  kind: string,
+  knownIds: Set<string>,
+): Promise<ScenarioItem> {
+  await expect
+    .poll(
+      async () => {
+        const list = await savedScenarios(page, diagnosisId);
+        return list.items.filter((item) => item.kind === kind && !knownIds.has(item.id)).length;
+      },
+      { timeout: 60_000, message: `等待新的 ${kind} 测算落库` },
+    )
+    .toBe(1);
+  const list = await savedScenarios(page, diagnosisId);
+  return list.items.filter((item) => item.kind === kind && !knownIds.has(item.id))[0];
+}
+
+async function idsByKind(page: Page, diagnosisId: string): Promise<Set<string>> {
+  const list = await savedScenarios(page, diagnosisId);
+  return new Set(list.items.map((item) => item.id));
+}
