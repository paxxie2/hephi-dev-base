+"""健康检查接口新增固定 ``service`` 字段的聚焦测试。
+
+覆盖（新任务，独立文件，不改动共享 fixture 和原有测试）：
+- 200：数据库可用时保留原有七个字段并新增固定 ``service``；
+- 503：数据库不可用时同样返回固定 ``service``，原有字段与状态码不变。
+
+测试使用独立临时 SQLite 与 ``TestClient``，不 mock 路由、``Health`` 或 ``db_status``。
+该测试是临时库/进程内接口测试，不代表真实部署环境的端到端验收。
+"""
+
+from __future__ import annotations
+
+import sqlite3
+from pathlib import Path
+
+from fastapi.testclient import TestClient
+
+from app.constants import APP_VERSION
+from app.db import init_db
+from app.main import create_app
+from app.settings import Settings
+
+SERVICE = "site-pnl-diagnosis"
+ORIGINAL_FIELDS = {
+    "status",
+    "db",
+    "seeded",
+    "dataVersion",
+    "modelConfigured",
+    "appVersion",
+    "detail",
+}
+
+
+def _settings(db_path: Path) -> Settings:
+    """显式配置；仅本文件使用，不触碰共享 fixture。"""
+    return Settings(
+        db_path=db_path,
+        host="127.0.0.1",
+        port=8000,
+        deepseek_api_key=None,
+        deepseek_base_url="https://api.deepseek.com",
+        deepseek_model="deepseek-flash",
+        request_timeout_seconds=30.0,
+        message_budget_seconds=90.0,
+    )
+
+
+def test_health_ok_includes_service(tmp_path: Path) -> None:
+    """200：建库并写入最小测试点位与 test-v1 元信息，断言固定 service 和原有字段。"""
+    db_path = tmp_path / "health-service-ok.db"
+    init_db(db_path)
+    conn = sqlite3.connect(db_path)
+    conn.execute(
+        "INSERT INTO sites (id, name, city, address, case_label, planned_capacity, data_version) "
+        "VALUES ('S1', '测试点位', '上海', '测试地址', '正常盈利', 3, 'test-v1')"
+    )
+    conn.execute("INSERT OR REPLACE INTO app_meta (key, value) VALUES ('data_version', 'test-v1')")
+    conn.commit()
+    conn.close()
+
+    app = create_app(_settings(db_path), seed=False)
+    with TestClient(app) as client:
+        response = client.get("/api/health")
+
+    assert response.status_code == 200
+    body = response.json()
+    assert set(body) == ORIGINAL_FIELDS | {"service"}
+    assert body["service"] == SERVICE
+    assert body["status"] == "ok"
+    assert body["db"] == "ok"
+    assert body["seeded"] is True
+    assert body["dataVersion"] == "test-v1"
+    assert body["modelConfigured"] is False
+    assert body["appVersion"] == APP_VERSION
+    assert body["detail"] is None
+    assert response.headers.get("X-Request-Id")
+
+
+def test_health_unavailable_db_includes_service(tmp_path: Path) -> None:
+    """503：以普通文件阻断数据库父路径，实际 SQLite 连接失败后仍返回固定 service。"""
+    blocker = tmp_path / "not-a-dir"
+    blocker.write_text("x")
+    broken_db = blocker / "nested" / "site.db"  # 父路径是文件，连接必然失败
+
+    app = create_app(_settings(broken_db), seed=False)
+    with TestClient(app, raise_server_exceptions=False) as client:
+        response = client.get("/api/health")
+
+    assert response.status_code == 503
+    body = response.json()
+    assert set(body) == ORIGINAL_FIELDS | {"service"}
+    assert body["service"] == SERVICE
+    assert body["status"] == "error"
+    assert body["db"] == "error"
+    assert body["seeded"] is False
+    assert body["dataVersion"] is None
+    assert body["modelConfigured"] is False
+    assert body["appVersion"] == APP_VERSION
+    assert isinstance(body["detail"], str) and body["detail"]
+    assert response.headers.get("X-Request-Id")
