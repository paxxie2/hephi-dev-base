diff --git a/web/e2e/08-history-pagination.spec.ts b/web/e2e/08-history-pagination.spec.ts
new file mode 100644
index 0000000..210e962
--- /dev/null
+++ b/web/e2e/08-history-pagination.spec.ts
@@ -0,0 +1,230 @@
+/**
+ * 旅程 8（Issue #16）：诊断历史默认每页 10 条与翻页体验。
+ *
+ * 真实浏览器（Playwright）+ 真实后端；**禁止** `page.route` / `route.fulfill` 伪造业务接口响应。
+ * 历史诊断通过真实公开 API `POST /api/diagnoses`（唯一 Idempotency-Key）创建，真实落库。
+ * 证据写入 `docs/acceptance/evidence/<E2E_EVIDENCE_LABEL>/`：E2E_EVIDENCE_LABEL 用于区分
+ * 基线（main）与改动后（本分支）的同场景对照运行。
+ *
+ * 空历史用例只对全新数据库有意义：服务已有历史时 skip（不把共享 DB 当空库，也不伪造空库）。
+ * 证据截图 step 名称使用 ASCII，避免生成非 ASCII 文件名。
+ */
+import { expect, test } from "@playwright/test";
+import type { Page, Response } from "@playwright/test";
+import { apiGet, apiPost, createJourneyLog, expectPnlMatchesDiagnosis } from "./helpers";
+
+const EVIDENCE_LABEL = process.env.E2E_EVIDENCE_LABEL ?? "history-pagination-10-r3";
+
+/**
+ * 页码提示定位：改动后元素带 `history-page-indicator` testid；基线（main）还没有该 testid，
+ * 但同一 `.pager > span` 文本已在基线存在，因此基线/改动后可用同一断言做同场景对照。
+ */
+function pageIndicator(page: Page) {
+  return page.locator('[data-testid="history-page-indicator"], .pager > span').first();
+}
+
+/** 当前历史列表里真实渲染的诊断 ID（来自真实 API 返回的记录）。 */
+async function visibleHistoryIds(page: Page): Promise<string[]> {
+  return page.locator('[data-testid^="history-item-"]').evaluateAll((elements) =>
+    elements.map((element) => (element.getAttribute("data-testid") ?? "").replace("history-item-", "")),
+  );
+}
+
+interface BrowserHealth {
+  consoleErrors: string[];
+  pageErrors: string[];
+  apiResponses: Array<{ url: string; status: number }>;
+}
+
+/** 记录浏览器控制台错误、页面异常与 /api 响应状态，供最终断言（非 mock，仅观测）。 */
+function trackBrowserHealth(page: Page): BrowserHealth {
+  const health: BrowserHealth = { consoleErrors: [], pageErrors: [], apiResponses: [] };
+  page.on("console", (message) => {
+    if (message.type() === "error") health.consoleErrors.push(message.text());
+  });
+  page.on("pageerror", (error) => health.pageErrors.push(String(error)));
+  page.on("response", (response: Response) => {
+    if (response.url().includes("/api/")) {
+      health.apiResponses.push({ url: response.url(), status: response.status() });
+    }
+  });
+  return health;
+}
+
+function expectBrowserHealth(health: BrowserHealth): void {
+  expect(health.consoleErrors, `存在浏览器 console error：${health.consoleErrors.join(" | ")}`).toHaveLength(0);
+  expect(health.pageErrors, `存在页面异常：${health.pageErrors.join(" | ")}`).toHaveLength(0);
+  const failed = health.apiResponses.filter((call) => call.status < 200 || call.status >= 300);
+  expect(failed, `存在非 2xx 的 /api 响应：${JSON.stringify(failed)}`).toHaveLength(0);
+}
+
+// 12 条真实诊断（10 个点位 + 2 个不同窗口），保证历史超过 10 条、需要 2 页。
+const CASES = [
+  ...Array.from({ length: 10 }, (_, index) => ({
+    siteId: `S${String(index + 1).padStart(2, "0")}`,
+    startDate: "2026-08-30",
+    endDate: "2026-09-28",
+  })),
+  { siteId: "S01", startDate: "2026-07-01", endDate: "2026-07-30" },
+  { siteId: "S02", startDate: "2026-08-01", endDate: "2026-08-30" },
+];
+
+test.describe("Journey 8: history pagination (10 items per page)", () => {
+  test("empty history shows clear hint and disables prev/next (fresh database)", async ({ page }) => {
+    const log = createJourneyLog(`${EVIDENCE_LABEL}/empty-history`);
+    log.attach(page);
+    const health = trackBrowserHealth(page);
+    try {
+      await page.goto("/");
+      const existing = (await apiGet(page, "/api/diagnoses?limit=1")).body as {
+        items: Array<{ id: string }>;
+        total: number;
+      };
+      test.skip(
+        existing.total > 0,
+        `服务已有 ${existing.total} 条历史诊断，空历史只能在全新数据库上验证`,
+      );
+
+      await page.getByTestId("nav-history").click();
+      // 空列表的 <ul> 尺寸为 0，Playwright 视为 hidden；这里断言元素存在（attached）而不是可见。
+      await expect(page.getByTestId("history-list")).toBeAttached();
+      await expect(page.getByText("还没有历史诊断")).toBeVisible();
+      await expect(pageIndicator(page)).toHaveText("第 1 / 1 页 · 共 0 条");
+      await expect(page.getByTestId("history-prev")).toBeDisabled();
+      await expect(page.getByTestId("history-next")).toBeDisabled();
+      log.record("empty-history", { total: existing.total });
+      await log.shot(page, "empty-history-hint", `total=${existing.total}`);
+      expectBrowserHealth(health);
+    } finally {
+      log.flush();
+    }
+  });
+
+  test("more than 10 histories: 10 per page, no duplicate/omission, boundaries and snapshot reopen", async ({
+    page,
+  }) => {
+    test.setTimeout(300_000);
+    const log = createJourneyLog(`${EVIDENCE_LABEL}/paging`);
+    log.attach(page);
+    const health = trackBrowserHealth(page);
+    try {
+      await page.goto("/");
+
+      // 1) 通过真实公开 API 创建 12 条诊断（真实落库，唯一 Idempotency-Key）。
+      const createdIds: string[] = [];
+      for (const [index, item] of CASES.entries()) {
+        const created = await apiPost(
+          page,
+          "/api/diagnoses",
+          { siteId: item.siteId, startDate: item.startDate, endDate: item.endDate },
+          { "Idempotency-Key": `e2e-history-${EVIDENCE_LABEL}-${Date.now()}-${index}` },
+        );
+        expect(created.status, `创建第 ${index + 1} 条诊断失败: ${JSON.stringify(created.body)}`).toBe(201);
+        createdIds.push((created.body as { id: string }).id);
+      }
+      log.record("create-real-histories", { count: createdIds.length, createdIds });
+
+      // 2) 打开历史页；以真实 API 列表作为“无重复/无遗漏”的对照。
+      await page.getByTestId("nav-history").click();
+      await expect(page.getByTestId("history-list")).toBeVisible();
+      const apiPage = (await apiGet(page, "/api/diagnoses?limit=100")).body as {
+        items: Array<{ id: string }>;
+        total: number;
+        limit: number;
+        offset: number;
+      };
+      expect(apiPage.total, "本用例要求全新数据库（应有恰好 12 条真实历史）").toBe(12);
+      expect(apiPage.items.length, "API limit=100 应返回全部 12 条历史").toBe(12);
+      expect(apiPage.limit).toBe(100);
+      const pageCount = Math.ceil(apiPage.total / 10);
+      expect(pageCount, "12 条历史在每页 10 条下应为 2 页").toBe(2);
+      log.record("api-list-baseline", {
+        total: apiPage.total,
+        limit: apiPage.limit,
+        offset: apiPage.offset,
+        ids: apiPage.items.map((item) => item.id),
+      });
+
+      // 首页截图先落盘：基线（每页 20 条）会在这里展示全部 12 条、页码提示“第 1 / 1 页”，作为缺陷证据。
+      await expect(pageIndicator(page)).toBeVisible();
+      await log.shot(
+        page,
+        "first-page-default",
+        `total=${apiPage.total} UI显示条数=${(await visibleHistoryIds(page)).length}`,
+      );
+
+      // 2.1) 先把同场景实际观测写入证据日志（基线=12 条/单页；改动后=10 条/第 1 页·共 2 页）。
+      //      随后同一断言在基线上会真实失败，这正是 Before/After 对照的缺陷证据。
+      const observedCount = (await visibleHistoryIds(page)).length;
+      const observedIndicator = (await pageIndicator(page).innerText()).replace(/\s+/g, " ").trim();
+      log.record("first-page-observation", {
+        renderedCount: observedCount,
+        indicator: observedIndicator,
+        prevDisabled: await page.getByTestId("history-prev").isDisabled(),
+        nextDisabled: await page.getByTestId("history-next").isDisabled(),
+        historyListRequests: health.apiResponses.filter((call) => /\/api\/diagnoses\?/.test(call.url)),
+      });
+
+      // 3) 首页恰好 10 条；上/下一页边界与页码提示正确。
