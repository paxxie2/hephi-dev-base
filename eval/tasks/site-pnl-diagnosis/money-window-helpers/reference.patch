diff --git a/backend/app/domain/money.py b/backend/app/domain/money.py
index 61bb903..84fbeaf 100644
--- a/backend/app/domain/money.py
+++ b/backend/app/domain/money.py
@@ -37,23 +37,31 @@ def format_date(value: date) -> str:
     return value.isoformat()
 
 
+def _parse_window(start: str, end: str) -> tuple[date, date]:
+    """把窗口起止 ISO 日期字符串解析为 ``date``。"""
+    return parse_date(start), parse_date(end)
+
+
+def _window_day_count(start_date: date, end_date: date) -> int:
+    """含首尾的自然日数量，即 ``(end_date - start_date).days + 1``。"""
+    return (end_date - start_date).days + 1
+
+
 def date_range(start: str, end: str) -> list[str]:
     """含首尾的自然日列表；start > end 返回空列表。"""
-    start_date = parse_date(start)
-    end_date = parse_date(end)
+    start_date, end_date = _parse_window(start, end)
     if start_date > end_date:
         return []
-    length = (end_date - start_date).days
-    return [(start_date + timedelta(days=offset)).isoformat() for offset in range(length + 1)]
+    day_count = _window_day_count(start_date, end_date)
+    return [(start_date + timedelta(days=offset)).isoformat() for offset in range(day_count)]
 
 
 def previous_window(start: str, end: str) -> tuple[str, str]:
     """紧邻当前窗口之前的等长自然日窗口（含首尾）。"""
-    start_date = parse_date(start)
-    end_date = parse_date(end)
-    length = (end_date - start_date).days + 1
+    start_date, end_date = _parse_window(start, end)
+    day_count = _window_day_count(start_date, end_date)
     prev_end = start_date - timedelta(days=1)
-    prev_start = prev_end - timedelta(days=length - 1)
+    prev_start = prev_end - timedelta(days=day_count - 1)
     return prev_start.isoformat(), prev_end.isoformat()
 
 
