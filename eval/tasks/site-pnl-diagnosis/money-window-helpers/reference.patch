@@ -88,3 +88,22 @@ def test_allocate_monthly_cents_rounding_and_leap_month() -> None:
     assert leap == {"2028-02-15": 34483}
     # 负数月金额（不应被静默截零，但保留舍入语义）
     assert allocate_monthly_cents(-1000, ["2026-09-01"]) == {"2026-09-01": -33}
+
+
+def test_date_window_refactor_characterization() -> None:
+    """行为保持重构的 characterization：边界输入的可观察行为保持不变。"""
+    # start > end 时 previous_window 的既有输出（不直观，但必须保持不变）。
+    assert previous_window("2026-09-03", "2026-09-01") == ("2026-09-04", "2026-09-02")
+    # 非法日期继续抛 ValueError。
+    for func, args in (
+        (date_range, ("2026-9-1", "2026-09-02")),
+        (previous_window, ("2026-9-1", "2026-09-02")),
+        (date_range, ("2026-02-30", "2026-02-30")),
+        (previous_window, ("2026-02-30", "2026-02-30")),
+    ):
+        try:
+            func(*args)
+        except ValueError:
+            pass
+        else:  # pragma: no cover
+            raise AssertionError(f"{func.__name__} must raise ValueError for {args}")
