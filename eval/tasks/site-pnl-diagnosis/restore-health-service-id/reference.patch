+"""健康检查固定 ``service`` 字段的聚焦测试。
+
+覆盖：
+- 200：临时 SQLite 已初始化并写入最小点位数据，响应保留原字段并包含固定 service。
+- 503：普通文件阻断数据库父目录，数据库访问失败时响应同样包含固定 service。
+
+本文件使用临时 SQLite + TestClient 验证路由序列化，属于聚焦测试，不代表实际进程、
+真实 HTTP 服务或端到端验收。
+"""
+
+from __future__ import annotations
+
+import sqlite3
+from pathlib import Path
+
+from fastapi.testclient import TestClient
+
+from app.constants import APP_VERSION
+from app.db import init_db
+from app.main import create_app
+from app.settings import Settings
+
+SERVICE = "site-pnl-diagnosis"
+
+
+def _settings(db_path: Path) -> Settings:
+    return Settings(
+        db_path=db_path,
+        host="127.0.0.1",
+        port=8000,
+        deepseek_api_key=None,
+        deepseek_base_url="https://api.deepseek.com",
+        deepseek_model="deepseek-flash",
+        request_timeout_seconds=30.0,
+        message_budget_seconds=90.0,
+    )
+
+
+def _seed_minimal_site(db_path: Path) -> None:
+    """初始化 schema 并写入最小点位与 test-v1 数据版本（不播种完整模拟数据）。"""
+    init_db(db_path)
+    conn = sqlite3.connect(db_path)
+    try:
+        conn.execute(
+            "INSERT INTO sites (id, name, city, address, case_label, planned_capacity, data_version) "
+            "VALUES ('S1', '测试点位', '上海', '测试地址', '正常盈利', 3, 'test-v1')"
+        )
+        conn.execute("INSERT OR REPLACE INTO app_meta (key, value) VALUES ('data_version', 'test-v1')")
+        conn.commit()
+    finally:
+        conn.close()
+
+
+def test_health_200_includes_fixed_service(tmp_path: Path) -> None:
+    db_path = tmp_path / "health-service.db"
+    _seed_minimal_site(db_path)
+
+    app = create_app(_settings(db_path), seed=False)
+    with TestClient(app) as client:
+        response = client.get("/api/health")
+
+    assert response.status_code == 200
+    assert response.headers.get("X-Request-Id")
+    assert response.json() == {
+        "service": SERVICE,
+        "status": "ok",
+        "db": "ok",
+        "seeded": True,
+        "dataVersion": "test-v1",
+        "modelConfigured": False,
+        "appVersion": APP_VERSION,
+        "detail": None,
+    }
+
+
+def test_health_503_includes_fixed_service(tmp_path: Path) -> None:
+    """数据库父路径是普通文件时连接必然失败，503 仍须包含固定 service 与原字段。"""
+    blocker = tmp_path / "not-a-dir"
+    blocker.write_text("x")
+    db_path = blocker / "nested" / "site.db"
+
+    app = create_app(_settings(db_path), seed=False)
+    with TestClient(app, raise_server_exceptions=False) as client:
+        response = client.get("/api/health")
+
+    assert response.status_code == 503
+    assert response.headers.get("X-Request-Id")
+    body = response.json()
+    assert set(body) == {
+        "service",
+        "status",
+        "db",
+        "seeded",
+        "dataVersion",
+        "modelConfigured",
+        "appVersion",
+        "detail",
+    }
+    assert body["service"] == SERVICE
+    assert body["status"] == "error"
+    assert body["db"] == "error"
+    assert body["seeded"] is False
+    assert body["dataVersion"] is None
+    assert body["modelConfigured"] is False
+    assert body["appVersion"] == APP_VERSION
+    assert body["detail"]
