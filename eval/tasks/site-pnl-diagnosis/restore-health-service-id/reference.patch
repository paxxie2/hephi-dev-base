+class _DeviceSpec:
+    name: str
+    purchase_cost_cents: int
+    depreciation_months: int
+    in_service_date: str
+    planned_capacity: int = 6
+
+
+@dataclass(frozen=True)
+class _SiteSpec:
+    id: str
+    name: str
+    city: str
+    address: str
+    case_label: str
+    orders_before: int
+    orders_after: int
